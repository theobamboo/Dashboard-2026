# ============================================================
# Living the Dream Trading — Environment Variables Template
# Copy this file to .env and fill in your keys.
# NEVER commit .env to version control.
# ============================================================

# --- App ---
ENV=development

# --- Crypto ---
COINGECKO_PRO_KEY=
COINGLASS_KEY=
CRYPTOQUANT_KEY=
INTOTHEBLOCK_KEY=

# --- Macro / Stocks ---
FRED_API_KEY=

# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database ---
# Leave blank to use default: sqlite:///./database/trading.db
DATABASE_URL=
